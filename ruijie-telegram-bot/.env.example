# Telegram BotFather token. Put the REAL value only in your private hosting
# environment/secrets settings. Never commit a real token to GitHub.
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenHere

# Comma-separated Telegram numeric user IDs allowed to control the bot.
ALLOWED_USER_IDS=111111111

# Ruijie/Reyee Cloud region used by your account.
RUIJIE_BASE_URL=https://cloud-as.ruijienetworks.com

# Optional: keep the Ruijie API App ID + Secret in the host's private secret
# store so the bot can reconnect automatically after a restart. Leave blank if
# you prefer to use /login in Telegram. Never commit real credentials here.
RUIJIE_APP_ID=
RUIJIE_APP_SECRET=
